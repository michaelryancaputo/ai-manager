{
  "name": "ai-manager",
  "version": "1.0.0",
  "description": "Interactive llama.cpp server and GGUF model manager",
  "type": "module",
  "bin": {
    "manager": "./dist/ai-manager.js"
  },
  "scripts": {
    "dev": "tsx src/ai-manager.ts",
    "build": "tsc",
    "start": "node dist/ai-manager.js",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build"
  },
  "keywords": [
    "llama.cpp",
    "gguf",
    "huggingface",
    "local-llm"
  ],
  "license": "MIT",
  "dependencies": {
    "@inquirer/input": "^4.2.2",
    "@inquirer/select": "^5.2.1",
    "chalk": "^5.6.2",
    "dotenv": "^17.2.3",
    "ora": "^9.4.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
