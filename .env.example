# Directory containing downloaded GGUF models
AI_MODELS_DIR=/path/to/ai/models

# Directory containing docker-compose.yml
AI_COMPOSE_DIR=/path/to/ai

# Symlink loaded by llama.cpp
AI_MODEL_LINK=/path/to/ai/models/model.gguf

# Docker Compose service and container names
AI_COMPOSE_SERVICE=llama
AI_CONTAINER_NAME=llama-cpp-intel

# llama.cpp API endpoint
AI_API_URL=http://127.0.0.1:8080

# Time to wait for a newly loaded model
AI_HEALTH_TIMEOUT_MS=120000
