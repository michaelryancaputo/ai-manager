# Supply-chain hardening: refuse to install any package version published
# more recently than this many days ago. Most malicious/compromised npm
# packages are caught and unpublished within days of release, so this
# window buys time for that to happen before we'd ever pull one in.
# Requires npm >= 11.10.0 (see "engines" in package.json) — older npm
# versions silently ignore this setting.
min-release-age=7
