{
  "name": "ai-manager",
  "version": "1.0.0",
  "description": "Interactive llama.cpp server and GGUF model manager",
  "type": "module",
  "bin": {
    "manager": "./dist/ai-manager.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "postbuild": "chmod +x dist/ai-manager.js",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "rebuild": "npm run clean && npm run build",
    "dev": "tsx src/ai-manager.ts",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "install-global": "npm install && npm run build && npm install -g ."
  },
  "keywords": [
    "llama.cpp",
    "gguf",
    "huggingface",
    "local-llm"
  ],
  "license": "MIT",
  "dependencies": {
    "@inquirer/input": "^4.2.2",
    "@inquirer/prompts": "^8.5.2",
    "@inquirer/select": "^5.2.1",
    "chalk": "^5.6.2",
    "dotenv": "^17.2.3",
    "ora": "^9.4.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  }
}
